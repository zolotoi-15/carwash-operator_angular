{
  "name": "Carwash Operator",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "angular.ng-template",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker",
        "mongodb.mongodb-vscode"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },

  "postCreateCommand": "npm --prefix backend ci && npm --prefix frontend ci",

  "forwardPorts": [3000, 4200, 27017, 1883, 8083],

  "portsAttributes": {
    "3000": { "label": "Backend API", "onAutoForward": "silent" },
    "4200": { "label": "Angular Dev", "onAutoForward": "openPreview" },
    "27017": { "label": "MongoDB", "onAutoForward": "silent" },
    "1883": { "label": "MQTT broker", "onAutoForward": "silent" },
    "8083": { "label": "MQTT WebSocket", "onAutoForward": "silent" }
  },

  "remoteUser": "node"
}
